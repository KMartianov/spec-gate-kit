    {"id": "negation-class-rejects-listed", "rel": "xpz", "pattern": "x[!p-z]z", "match": false},
    {"id": "dot-is-literal-match", "rel": "a.b", "pattern": "a.b", "match": true},
    {"id": "dot-is-not-wildcard", "rel": "axb", "pattern": "a.b", "match": false},
    {"id": "plus-is-literal", "rel": "a+b", "pattern": "a+b", "match": true},
    {"id": "doublestar-zero-components", "rel": "x/y", "pattern": "x/**/y", "match": true},
    {"id": "doublestar-many-components", "rel": "x/p/q/y", "pattern": "x/**/y", "match": true},
    {"id": "anchoring-trailing-newline-rejected", "rel": "src/app.ts\n", "pattern": "src/*.ts", "match": false},
