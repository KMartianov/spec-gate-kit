{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/Projects/**": "allow",
      "/tmp/opencode/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "cmake *": "allow",
      "make *": "allow",
      "ninja *": "allow",
      "ctest *": "allow",
      "pytest *": "allow",
      "uv run*": "allow",
      "uv sync*": "allow",
      "python -m *": "allow",
      "python3 -m *": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf /home/*": "deny",
      "mkfs*": "deny",
      "dd if=* of=/dev/*": "deny",
      "chmod -R 777 *": "deny",
      "sh -c *": "deny",
      "bash -c *": "deny",
      "eval *": "deny",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask"
    }
  },
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (free)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2:free": {
          "name": "GLM 5.2 (free)"
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "Nemotron 3 Super 120B (free)"
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (free)"
        },
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (free)"
        },
        "google/gemma-4-31b-it:free": {
