#!/usr/bin/env python3
"""Disable the spec-gate for one project by dropping a GATE-OFF marker.

Usage:
    gate-off [<path-inside-project>]

Creates ``<root>/.slim/GATE-OFF`` containing ``disabled by human at <ISO8601>``,
where ``<root>`` is the nearest ancestor containing ``.slim/spec`` (the walk
stops at a ``.git`` boundary, ``$HOME`` and ``/``). Refuses when there is no
gated project to switch off. The marker is a human escape hatch: while it exists
the spec-gate plugin lets code edits through.
"""

from __future__ import annotations

import datetime
import os
import sys
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
SPEC_REL = Path(".slim") / "spec"
MARKER_NAME = "GATE-OFF"

USAGE = """Usage:
    gate-off [<path-inside-project>] [--help]

With no argument the current directory is used. Creates the human escape-hatch
marker ``<root>/.slim/GATE-OFF`` that disables the spec-gate for this project.
"""


def die(message: str, code: int = 1) -> None:
    print(f"gate-off: error: {message}", file=sys.stderr)
    raise SystemExit(code)


def find_root(start: Path) -> Path | None:
    """Nearest ancestor holding .slim/spec; bounded by .git, $HOME and /."""
    directory = start if start.is_dir() else start.parent
    while True:
        if (directory / SPEC_REL).is_dir():
            return directory
        if (directory / ".git").exists():
            return None
        if directory == HOME or directory == directory.parent:
            return None
        directory = directory.parent


def resolve_target(arg: str | None) -> Path:
    if arg is None:
        return Path.cwd().resolve()
    target = Path(arg).expanduser()
    if not target.is_absolute():
        target = Path.cwd() / target
    target = target.resolve()
    if not target.exists():
        die(f"path not found: {target}")
    return target


def main(argv: list[str]) -> int:
    args = argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(USAGE, end="")
        return 0
    if len(args) > 1:
        die(f"unexpected argument: {args[1]}")

    target = resolve_target(args[0] if args else None)
    root = find_root(target)
    if root is None:
        die(f"no project root containing {SPEC_REL} at or above {target}; nothing to switch off")
    root = root.resolve()
    spec_dir = root / SPEC_REL
    if not spec_dir.is_dir():
        die(f"{spec_dir} does not exist; nothing to switch off")

    marker = root / ".slim" / MARKER_NAME
    stamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
    try:
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(f"disabled by human at {stamp}\n", encoding="utf-8")
    except OSError as exc:
        die(f"cannot write marker {marker}: {exc}")
    print(marker)
    print("warning: code edits in this project are no longer gated (spec-gate disabled)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
