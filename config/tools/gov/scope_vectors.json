    {"id": "star-alone-does-not-cross-slash", "rel": "a/b", "pattern": "*", "match": false},
    {"id": "question-matches-one-char", "rel": "abc", "pattern": "a?c", "match": true},
    {"id": "question-does-not-match-slash", "rel": "a/c", "pattern": "a?c", "match": false},
    {"id": "question-does-not-match-zero", "rel": "ac", "pattern": "a?c", "match": false},
    {"id": "question-does-not-match-two", "rel": "abbc", "pattern": "a?c", "match": false},
    {"id": "class-range-matches", "rel": "xyz", "pattern": "x[p-z]z", "match": true},
